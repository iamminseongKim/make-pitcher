{
  "name": "ace-project",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "sim": "esbuild sim/sim.ts --bundle --platform=node --outfile=node_modules/.cache/sim.cjs --log-level=warning && node node_modules/.cache/sim.cjs",
    "sim:fip": "esbuild sim/fip-calibration.ts --bundle --platform=node --outfile=node_modules/.cache/fip.cjs --log-level=warning && node node_modules/.cache/fip.cjs",
    "sim:platoon": "esbuild sim/platoon.ts --bundle --platform=node --outfile=node_modules/.cache/platoon.cjs --log-level=warning && node node_modules/.cache/platoon.cjs",
    "test": "esbuild sim/regression.ts --bundle --platform=node --outfile=node_modules/.cache/regression.cjs --log-level=warning && node node_modules/.cache/regression.cjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.28.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.5"
  }
}
